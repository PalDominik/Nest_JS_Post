<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <ul>
        <% viragok.forEach(virag => { %>
            <li><%= virag.szin %> <%= virag.fajta %> <%= virag.ar %></li>
        <% }) %>
    </ul>

    <form method="post">
        <input type="text" name="fajta">
        <select name="szin">
            <option value="piros">Piros</option>
            <option value="sarga">Sárga</option>
            <option value="feher">Fehér</option>
        </select>
        <input type="number" name="ar">

        <p class="errormessage">
            <%= locals.error %>
        </p>

        <button type="submit">Új virág</button>

    </form>
</body>
</html>